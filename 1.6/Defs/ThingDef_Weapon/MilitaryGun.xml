	<!-- DMS_CombatShotgun -->
	<ThingDef ParentName="DMS_AutomatroidGun">
		<defName>DMS_KS23K</defName>
		<label>Tula combat shotgun</label>
		<description>A modernized large-caliber shotgun, fed by detachable box magazines to deliver sustained fire suppression. The metal slugs it uses are remarkably effective even against heavily armored targets.</description>
		<weaponClasses>
			<li>ShortShots</li>
			<li>RangedHeavy</li>
			<li>Ranged</li>
		</weaponClasses>
		<weaponTags>
			<li>DMS_KS23K</li>
			<li>DMS_MechWeaponMedium</li>
			<li>DMS_MechWeaponShotgun</li>
			<li>A_RC</li>
			<li>A_RC_LongRifle</li>
			<li>A_SG_LongRifle</li>
		</weaponTags>
		<graphicData>
			<texPath>Things/Weapons/DMS_Weapon_KS23K</texPath>
			<drawSize>1.25</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<WorkToMake>41000</WorkToMake>
			<Mass>6.75</Mass>
			<AccuracyTouch>0.80</AccuracyTouch>
			<AccuracyShort>0.76</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.45</AccuracyLong>
			<RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
		</statBases>
		<recipeMaker Inherit="False" />
		<!-- <recipeMaker>
			<researchPrerequisites>
				<li>GasOperation</li>
				<li>DMS_EquipmentElite</li>
			</researchPrerequisites>
		</recipeMaker> -->
		<costList>
			<Tungsteel>70</Tungsteel>
			<ComponentStamped>4</ComponentStamped>
		</costList>
		<!-- 彈種切換: 制式的四種23mm彈藥。實心獨頭彈(預設) / 鹿彈 / 橡膠彈 / 震撼彈 -->
		<comps>
			<li Class="Fortified.CompProperties_AmmoSwitch">
				<defaultIndex>0</defaultIndex>
				<includeDefaultAmmo>false</includeDefaultAmmo>
				<switchCooldown>120</switchCooldown>
				<soundSwitch>Interact_Rifle</soundSwitch>
				<ammos>
					<li>
						<label>Barrikada slug</label>
						<description>The steel slug the weapon was built around. It reaches out to the full length of the barrel and defeats plating that pellets merely scratch.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Slug</iconPath>
						<useDefaultProjectile>true</useDefaultProjectile>
					</li>
					<li>
						<label>Shrapnel-25 shot</label>
						<description>A lead pellet load for close work against unarmored crowds. Its reach is limited.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Pellet</iconPath>
						<projectileDef>DMS_Bullet_KS23K_Shrapnel</projectileDef>
						<burstShotCountOverride>3</burstShotCountOverride>
						<rangeFactor>0.7</rangeFactor>
						<accuracyFactor>0.9</accuracyFactor>
					</li>
					<li>
						<label>Volna-R rubber slug</label>
						<description>A less-lethal rubber slug for dispersal and for taking prisoners intact. Its range is short, and it has no penetration worth speaking of.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Rubber</iconPath>
						<projectileDef>DMS_Bullet_KS23K_Volna</projectileDef>
						<burstShotCountOverride>1</burstShotCountOverride>
						<rangeFactor>0.6</rangeFactor>
					</li>
					<li>
						<label>Zvezda stun shell</label>
						<description>A flash-bang shell that bursts on impact and puts everything nearby on the floor for a few seconds without wounding any of it. It does not care whose side the target is on, so place it accordingly.</description>
						<iconPath>UI/Ammoswitch/Shotgun_EMP</iconPath>
						<projectileDef>DMS_Bullet_KS23K_Zvezda</projectileDef>
						<burstShotCountOverride>1</burstShotCountOverride>
						<rangeFactor>0.75</rangeFactor>
						<warmUpFactor>1.2</warmUpFactor>
					</li>
				</ammos>
			</li>
		</comps>
		<verbs>
			<li>
				<!-- 人類可用武器一律用 Verb_Shoot_AmmoSwitch, Verb_LaunchProjectile_AmmoSwitch 不會給射擊經驗 -->
				<verbClass>Fortified.Verb_Shoot_AmmoSwitch</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_DMS_CombatShotgun</defaultProjectile>
				<warmupTime>1.2</warmupTime>
				<range>18.9</range>
				<burstShotCount>2</burstShotCount>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<soundCast>Shot_Shotgun</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.5,0.5)</drawSize>
				<offsets>
					<li>(0.5,0)</li>
				</offsets>
				<isAlternately>true</isAlternately>
			</li>
			<li Class="Fortified.HeavyEquippableExtension">
				<EquippableDef>AverageHumanCanUse</EquippableDef>
			</li>
		</modExtensions>
	</ThingDef>

