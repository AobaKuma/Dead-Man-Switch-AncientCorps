		<weaponClasses>
			<li>LongShots</li>
			<li>Ranged</li>
		</weaponClasses>
		<weaponTags>
			<li>DMS_MechWeaponLongRifle</li>
			<li>DMS_PKM</li>
			<li>A_SuppressWeapon</li>
			<li>A_MG_Light</li>
			<li>CE_AI_LMG</li>
			<li>Bipod_SAW</li>
		</weaponTags>
