		</projectile>
	</ThingDef>

	<!-- 「波浪-R」橡膠彈: 非致命驅散與活捉 -->
	<ThingDef ParentName="DMS_BaseSwitchableBullet">
		<defName>DMS_Bullet_KS23K_Volna</defName>
		<label>23mm rubber slug</label>
		<description>A 23mm rubber slug loaded to a reduced charge. At this calibre a less-lethal round still breaks ribs, which the manuals describe as compliance.</description>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Big</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<color>(90,90,95)</color>
			<drawSize>0.85</drawSize>
		</graphicData>
		<projectile>
			<damageDef>Blunt</damageDef>
			<damageAmountBase>22</damageAmountBase>
			<stoppingPower>4</stoppingPower>
			<armorPenetrationBase>0.10</armorPenetrationBase>
			<speed>50</speed>
		</projectile>
	</ThingDef>

	<!-- 「星辰」震撼彈: 命中即炸的暈眩彈, 零傷害。用原版 Stun 傷害型別,
	     自訂 DamageDef 無法暈眩 pawn (StunHandler.CanBeStunnedByDamage 只認 Stun/EMP/NerveStun/MechBandShockwave) -->
	<ThingDef ParentName="DMS_BaseSwitchableBullet">
		<defName>DMS_Bullet_KS23K_Zvezda</defName>
		<label>23mm stun shell</label>
		<description>A 23mm flash-bang shell with an impact fuze. It wounds nothing and stops everything within a couple of paces of where it lands, friend and enemy alike, for just long enough to close the distance.</description>
