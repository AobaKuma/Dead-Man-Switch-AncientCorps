<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    採用 FFF 1.7 的新系統：設施警報網路、地下封鎖、機兵殘骸回收、駐軍化站點生成。
    這些建築在既有佈局裡已經擺好位置（每張地下圖各有 1 座指揮核心 / 處理陣列 / 通風扇、1 座電梯），
    所以「只加 comp、不改 236 KB 的 StructureDef 佈局」。
    Adopting FFF 1.7 systems: facility alarm network, underground lockdown, hulk recycling and a
    garrisoned site gen step. The required buildings are already placed in the authored layouts, so
    this only adds comps — the large StructureDef files are untouched.
  -->

  <!-- ===== 指揮核心：偵測入侵者 → 累積警報；滿 100% 時啟動地下封鎖 ===== -->
  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DMSAC_GestaltEngine"]/comps</xpath>
        <value>
          <li Class="Fortified.CompProperties_AlertScanner">
            <scanWidth>31</scanWidth>
            <scanHeight>31</scanHeight>
            <radius>0</radius>
            <requireLOS>true</requireLOS>
            <detectsInvisible>false</detectsInvisible>
            <checkInterval>250</checkInterval>
            <rearmInterval>2500</rearmInterval>
            <alertIncrement>25</alertIncrement>
            <signalString>DMSAC_FacilityAlarm</signalString>
          </li>
          <li Class="Fortified.CompProperties_FacilityLockdownController">
            <checkInterval>60</checkInterval>
          </li>
          <li Class="CompProperties_Hackable">
            <defence>2</defence>
            <intellectualSkillPrerequisite>8</intellectualSkillPrerequisite>
            <hackedMessage>The command core accepted the override; the facility lockdown is disarmed.</hackedMessage>
            <hackedLetterLabel>Command core hacked</hackedLetterLabel>
            <hackedLetterText>The command core has been overridden. The facility's lockdown controller is disarmed, and the lifts will keep working.\n\nThe corps will notice, eventually.</hackedLetterText>
            <hackedLetterDef>PositiveEvent</hackedLetterDef>
          </li>
        </value>
      </li>

      <!-- 處理陣列：警報過半後從陣列裡放出機兵 / Process array releases mechs once the alarm is above half -->
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DMSAC_BandNode"]/comps</xpath>
        <value>
          <li Class="Fortified.CompProperties_AlertEffector_ReleaseEntity">
            <listenSignal>DMSAC_FacilityAlarm</listenSignal>
            <minAlertLevel>0.5</minAlertLevel>
            <inactiveWhenFogged>true</inactiveWhenFogged>
            <triggerChance>0.5</triggerChance>
            <pawnKindDef>DMS_Mech_Molot_Mosta</pawnKindDef>
            <countToSpawn>2</countToSpawn>
            <spawnFactionDef>DMS_AncientCorps</spawnFactionDef>
          </li>
        </value>
      </li>

      <!-- 通風扇：警報滿載時從通風井放出步兵機兵 / The vent disgorges infantry at full alarm -->
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DMSAC_Building_AirFan"]/comps</xpath>
        <value>
          <li Class="Fortified.CompProperties_AlertEffector_ReleaseEntity">
            <listenSignal>DMSAC_FacilityAlarm</listenSignal>
            <minAlertLevel>0.75</minAlertLevel>
            <inactiveWhenFogged>true</inactiveWhenFogged>
            <oneShot>false</oneShot>
            <pawnKindDef>DMS_Mech_Mushketer_SAR</pawnKindDef>
            <countToSpawn>3</countToSpawn>
            <spawnFactionDef>DMS_AncientCorps</spawnFactionDef>
          </li>
        </value>
      </li>

      <!-- 地表電梯：封鎖後拒絕進出，但提供需要工程的緊急解鎖 / Surface lift gates the facility -->
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DMSAC_Building_LiftShaft"]</xpath>
        <value>
          <comps>
            <li Class="Fortified.CompProperties_FacilityLockdownGate">
              <overrideWork>6000</overrideWork>
              <overrideSkillPrerequisite>6</overrideSkillPrerequisite>
            </li>
          </comps>
        </value>
      </li>
    </operations>
  </Operation>

  <!-- ===== 機兵殘骸可回收（FFF Recycleable）===== -->
  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DMS_Mech_Saray"]</xpath>
        <value>
          <comps>
            <li Class="Fortified.CompProperties_Recycleable">
              <products>
                <Steel>25</Steel>
                <ComponentStamped>1</ComponentStamped>
              </products>
              <yieldFactor>0.8</yieldFactor>
              <workTicks>400</workTicks>
              <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
              <allowDead>true</allowDead>
              <playerFactionOnly>true</playerFactionOnly>
            </li>
          </comps>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DMS_Mech_Molot" or defName="DMS_Mech_Tsvetnik"]/comps</xpath>
        <value>
          <li Class="Fortified.CompProperties_Recycleable">
            <products>
              <Steel>60</Steel>
              <Tungsteel>20</Tungsteel>
              <ComponentStamped>2</ComponentStamped>
            </products>
            <yieldFactor>0.8</yieldFactor>
            <workTicks>600</workTicks>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <allowDead>true</allowDead>
            <playerFactionOnly>true</playerFactionOnly>
          </li>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DMS_Mech_Zabor" or defName="DMS_Mech_Gorod" or defName="DMS_Mech_MusicBox"]/comps</xpath>
        <value>
          <li Class="Fortified.CompProperties_Recycleable">
            <products>
              <Steel>90</Steel>
              <Tungsteel>40</Tungsteel>
              <ComponentStamped>3</ComponentStamped>
            </products>
            <yieldFactor>0.8</yieldFactor>
            <workTicks>900</workTicks>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <allowDead>true</allowDead>
            <playerFactionOnly>true</playerFactionOnly>
          </li>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DMS_Mech_Krepost" or defName="DMS_Mech_Pravda"]/comps</xpath>
        <value>
          <li Class="Fortified.CompProperties_Recycleable">
            <products>
              <Steel>150</Steel>
              <Tungsteel>80</Tungsteel>
              <ComponentStamped>6</ComponentStamped>
            </products>
            <yieldFactor>0.8</yieldFactor>
            <workTicks>1500</workTicks>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <allowDead>true</allowDead>
            <playerFactionOnly>true</playerFactionOnly>
          </li>
        </value>
      </li>
    </operations>
  </Operation>

  <!-- ===== 兵器墳場：改用駐軍化生成（殘骸散落 + 戰利品 + 守軍），布局檔不動 ===== -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GenStepDef[linkWithSite="DMSAC_Graveyard"]/genStep</xpath>
    <value>
      <genStep Class="Fortified.Structures.GenStep_FFFGarrisonedStructure">
        <structureLayoutDefs>
          <li>DMSAC_Graveyard_A</li>
          <li>DMSAC_Graveyard_B</li>
          <li>DMSAC_Graveyard_C</li>
        </structureLayoutDefs>
        <fullClear>true</fullClear>
        <preventBridgeable>true</preventBridgeable>
        <filthTypes>
          <li>Filth_Dirt</li>
          <li>Filth_Trash</li>
          <li>Filth_RubbleBuilding</li>
        </filthTypes>
        <symbolResolvers>
          <li>kcsg_storagezone</li>
          <li>kcsg_randomdamage</li>
          <li>kcsg_randomfilth</li>
          <li>kcsg_randomterrainremoval</li>
          <li>kcsg_randomroofremoval</li>
          <li>kcsg_randomitemremoval</li>
        </symbolResolvers>
        <debrisDef>DMSAC_Building_DerelictMech_Medium</debrisDef>
        <debrisCount>18~30</debrisCount>
        <scatterRadius>24</scatterRadius>
        <lootMaker>DMSAC_LootMaker</lootMaker>
        <lootPrefersStorage>true</lootPrefersStorage>
        <spawnDefenders>true</spawnDefenders>
        <defendRadius>16</defendRadius>
      </genStep>
    </value>
  </Operation>
</Patch>
