<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    榖倉（Saray）是無人設施例行巡邏與二線保養用的雜務機，所以放進巡邏池與未啟動機兵池；
    權重刻意壓低（它是後勤機，不是主戰力）。
    The Saray is the odd-job / depot patrol platform, so it joins the patrol pools and the
    deactivated-mech pools at a deliberately low weight.
  -->
  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <!-- 巡邏池：駐地、兵器墳場、地下設施入口、後勤終端 / patrol pools -->
      <li Class="PatchOperationAdd">
        <xpath>Defs/WorldObjectDef[defName="DMSAC_Garrison" or defName="DMSAC_Graveyard" or defName="DMSAC_FacilityEnterance" or defName="DMSAC_LogisticTerminal"]/comps/li[@Class="AncientCorps.WorldObjectCompProperties_PatrolSquad"]/possibleGeneratePawn</xpath>
        <value>
          <DMS_Mech_Saray>3</DMS_Mech_Saray>
        </value>
      </li>
      <!-- 未啟動／殘骸機兵池（小型） / small deactivated + inactivated mech pools -->
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="DMSAC_Building_DeactivatedSmallMech" or defName="DMSAC_Building_InactivatedSmallMech"]/modExtensions/li[@Class="Fortified.ModExtension_DeactivatedMech"]/possibleGeneratePawn</xpath>
        <value>
          <DMS_Mech_Saray>2</DMS_Mech_Saray>
        </value>
      </li>

      <!-- 火力召喚信標：低權重出現在軍用貨箱戰利品裡 / fire-mission beacon as rare crate loot -->
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingSetMakerDef[defName="DMSAC_CrateLoots"]/root/options</xpath>
        <value>
          <li>
            <weight>2</weight>
            <thingSetMaker Class="ThingSetMaker_StackCount">
              <fixedParams>
                <filter>
                  <thingDefs>
                    <li>DMSAC_BossCaller</li>
                  </thingDefs>
                </filter>
                <countRange>1</countRange>
              </fixedParams>
            </thingSetMaker>
          </li>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
