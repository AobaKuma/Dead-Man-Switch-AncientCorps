<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    八音盒 / "Music Box" — 籬笆底盤的重型改造型小 Boss。
    一對從直升機拆下來的集群火箭發射艙，外加一挺榴彈機槍；成群部署時密集發射的火箭
    被前線自己稱為「噩夢交響樂」。
    An in-field conversion of the Zabor chassis: a pair of helicopter cluster rocket nests on the
    shoulders plus a grenade machine gun. Massed, the ripple fire is the "Nightmare Symphony".

    美術：目前用 zabor 貼圖佔位，專屬貼圖到位後只要換 PawnKind 的 bodyGraphicData.texPath。
    Art: currently using the zabor texture as a placeholder; swap bodyGraphicData.texPath later.
  -->

  <!-- 集群火箭發射艙 / cluster rocket nest -->
  <ThingDef ParentName="DMS_AutomatroidTurretGun">
    <defName>DMSAC_Gun_ClusterRocketPod</defName>
    <label>cluster rocket nest</label>
    <description>A helicopter cluster rocket nest adapted to a mech shoulder mount. Six tubes ripple-fire in a single salvo and cover a very wide arc.</description>
    <graphicData>
      <texPath>Things/Projectiles/DMS_S8Rocket/shell</texPath>
      <drawSize>1.2</drawSize>
    </graphicData>
    <statBases>
      <RangedWeapon_Cooldown>6.5</RangedWeapon_Cooldown>
      <Mass>40</Mass>
    </statBases>
    <weaponTags>
      <li>DMSAC_MusicBox</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>DMSAC_Bullet_S8Rocket</defaultProjectile>
        <warmupTime>2.5</warmupTime>
        <minRange>6</minRange>
        <range>34.9</range>
        <forcedMissRadius>3</forcedMissRadius>
        <burstShotCount>6</burstShotCount>
        <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
        <soundCast>RocketswarmLauncher_Fire</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>15</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>true</canTargetPawns>
          <canTargetBuildings>true</canTargetBuildings>
        </targetParams>
      </li>
    </verbs>
  </ThingDef>

  <!-- 機體：以籬笆為底，加厚裝甲、肩上兩座火箭艙 -->
  <ThingDef ParentName="DMS_Mech_Zabor">
    <defName>DMS_Mech_MusicBox</defName>
    <label>music box</label>
    <description>A Zabor hull rebuilt around a pair of helicopter cluster rocket nests. The conversion trades the stock frontal armour scheme for more mass, more power draw, and the ability to delete a grid square in one salvo.\n\nLine units call the resulting barrage the "Nightmare Symphony". If you hear the pods start their ripple, the correct response is to already be somewhere else.</description>
    <statBases>
      <MoveSpeed>2.4</MoveSpeed>
      <ArmorRating_Sharp>1.4</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.9</ArmorRating_Blunt>
      <AimingDelayFactor>1.0</AimingDelayFactor>
      <BandwidthCost MayRequire="Ludeon.Rimworld.Biotech">6</BandwidthCost>
      <WastepacksPerRecharge MayRequire="Ludeon.Rimworld.Biotech">5</WastepacksPerRecharge>
    </statBases>
    <race>
      <baseBodySize>1.8</baseBodySize>
      <baseHealthScale>2.8</baseHealthScale>
    </race>
    <comps>
      <li Class="Fortified.CompPropertiesMultipleTurretGun">
        <subTurrets>
          <li>
            <ID>left rocket nest</ID>
            <turret>DMSAC_Gun_ClusterRocketPod</turret>
            <autoAttack>true</autoAttack>
            <warmingTime>4</warmingTime>
            <angleOffset>-90</angleOffset>
            <renderNodeProperties>
              <li>
                <nodeClass>Fortified.PawnRenderNode_SubTurretGun</nodeClass>
                <workerClass>Fortified.PawnRenderNodeWorker_SubTurretGun</workerClass>
                <parentTagDef>Body</parentTagDef>
                <drawSize>1.5</drawSize>
                <baseLayer>20</baseLayer>
                <pawnType>Any</pawnType>
                <drawData>
                  <dataEast>
                    <offset>(-0.3,0,1.0)</offset>
                  </dataEast>
                  <dataWest>
                    <offset>(0.3,0,1.0)</offset>
                    <rotationOffset>180</rotationOffset>
                  </dataWest>
                  <dataSouth>
                    <offset>(0.9,0,0.3)</offset>
                  </dataSouth>
                  <dataNorth>
                    <offset>(-0.9,0,0.3)</offset>
                  </dataNorth>
                </drawData>
              </li>
            </renderNodeProperties>
          </li>
          <li>
            <ID>right rocket nest</ID>
            <turret>DMSAC_Gun_ClusterRocketPod</turret>
            <autoAttack>true</autoAttack>
            <warmingTime>4</warmingTime>
            <angleOffset>-90</angleOffset>
            <renderNodeProperties>
              <li>
                <nodeClass>Fortified.PawnRenderNode_SubTurretGun</nodeClass>
                <workerClass>Fortified.PawnRenderNodeWorker_SubTurretGun</workerClass>
                <parentTagDef>Body</parentTagDef>
                <drawSize>1.5</drawSize>
                <baseLayer>20</baseLayer>
                <pawnType>Any</pawnType>
                <drawData>
                  <dataEast>
                    <offset>(-0.3,0,-0.4)</offset>
                  </dataEast>
                  <dataWest>
                    <offset>(0.3,0,-0.4)</offset>
                    <rotationOffset>180</rotationOffset>
                  </dataWest>
                  <dataSouth>
                    <offset>(-0.9,0,0.3)</offset>
                  </dataSouth>
                  <dataNorth>
                    <offset>(0.9,0,0.3)</offset>
                  </dataNorth>
                </drawData>
              </li>
            </renderNodeProperties>
          </li>
        </subTurrets>
      </li>
    </comps>
    <modExtensions Inherit="False">
      <li Class="Fortified.MechWeaponExtension">
        <EnableWeaponFilter>true</EnableWeaponFilter>
        <UsableWeaponTags>
          <li>SimpleGun</li>
          <li>DMS_MechWeaponLight</li>
          <li>A_MG_GrenadeLauncher</li>
          <li>ShortShots</li>
        </UsableWeaponTags>
        <BypassUsableWeapons>
          <li>DMS_AtlantGrenadeLauncher</li>
        </BypassUsableWeapons>
        <EnableTechLevelFilter>true</EnableTechLevelFilter>
        <UsableTechLevels>
          <li>Industrial</li>
        </UsableTechLevels>
      </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="BaseAncientAutomatroidKind">
    <defName>DMS_Mech_MusicBox</defName>
    <label>music box</label>
    <race>DMS_Mech_MusicBox</race>
    <isFighter>true</isFighter>
    <isBoss>true</isBoss>
    <combatPower>650</combatPower>
    <maxPerGroup>1</maxPerGroup>
    <weaponTags>
      <li>DMSAC_MusicBox</li>
      <li>DMS_AtlantGrenadeLauncher</li>
    </weaponTags>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Automatroid/zabor</texPath>
          <shaderType>CutoutComplex</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3.4</drawSize>
          <shadowData>
            <volume>(1.3,1,1.3)</volume>
            <offset>(0,0,-0.3)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Automatroid/zabor</texPath>
          <shaderType>CutoutComplex</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3.4</drawSize>
          <shadowData>
            <volume>(1.3,1,1.3)</volume>
            <offset>(0,0,-0.3)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <BossDef>
    <defName>DMSAC_Boss_MusicBox</defName>
    <kindDef>DMS_Mech_MusicBox</kindDef>
    <appearAfterTicks>60000</appearAfterTicks>
  </BossDef>

  <BossgroupDef ParentName="BaseBossgroupNonMechanitor">
    <defName>DMSAC_Bossgroup_MusicBox</defName>
    <boss>DMSAC_Boss_MusicBox</boss>
    <modExtensions>
      <!-- 讓 FFF 的召喚器可以直接呼叫（原版 UI 不會把它當成可召喚首領） -->
      <li Class="Fortified.CallableExtension" />
    </modExtensions>
    <waves>
      <li>
        <bossCount>1</bossCount>
        <escorts>
          <DMS_Mech_Zabor>3</DMS_Mech_Zabor>
          <DMS_Mech_Molot>2</DMS_Mech_Molot>
        </escorts>
      </li>
      <li>
        <bossCount>1</bossCount>
        <escorts>
          <DMS_Mech_Zabor>4</DMS_Mech_Zabor>
          <DMS_Mech_Gorod>2</DMS_Mech_Gorod>
        </escorts>
      </li>
      <li>
        <bossCount>1</bossCount>
        <escorts>
          <DMS_Mech_Zabor>6</DMS_Mech_Zabor>
          <DMS_Mech_Gorod>2</DMS_Mech_Gorod>
          <DMS_Mech_Molot_Kamin>2</DMS_Mech_Molot_Kamin>
        </escorts>
      </li>
    </waves>
  </BossgroupDef>

  <!-- 召喚器：把八音盒的集群火箭招呼到自己的地圖上（TODO 的 boss group caller） -->
  <ThingDef ParentName="DMSAC_SiteIntel">
    <defName>DMSAC_BossCaller</defName>
    <label>fire mission beacon</label>
    <description>A captured corps fire-mission beacon rebuilt to transmit a forged "music box" call sign. Using it puts a Music Box and her escorts on the ground next to you; the corps never asks who called.\n\nDo not use it indoors. Do not use it next to the chemfuel store. If you do use it, have an exit.</description>
    <descriptionHyperlinks>
      <ThingDef>DMS_Mech_MusicBox</ThingDef>
      <HediffDef>DMSAC_StructuralDamage</HediffDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Resource/RecoverTransmitter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>1800</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Transmit fire mission</useLabel>
        <useDuration>300</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="Fortified.CompProperties_UseEffectSummonRaid">
        <bossgroupDef>DMSAC_Bossgroup_MusicBox</bossgroupDef>
        <effecterDef>DMSAC_ImpactDust</effecterDef>
      </li>
    </comps>
  </ThingDef>
</Defs>
