        <pointsFactor>1.1</pointsFactor>
        <minPoints>500</minPoints>
        <maxPoints>6000</maxPoints>
        <tiers>
          <li>
            <minDefcon>0</minDefcon>
            <options>
              <DMS_Mech_Mushketer_AR>3</DMS_Mech_Mushketer_AR>
              <DMS_Mech_Mushketer_SAR>2</DMS_Mech_Mushketer_SAR>
              <DMS_Mech_Molot>2</DMS_Mech_Molot>
              <DMS_Mech_Molot_Reservoir>1</DMS_Mech_Molot_Reservoir>
