    <description>A ground entrance shaft to an underground complex, which may not be it's only exit, but the exterior of the shaft facility contains a large amount of military supplies waiting to be circulated.</description>
    <workerClass>AncientCorps.SitePartWorker_DMSAC_Installation</workerClass>
    <modExtensions>
      <li Class="Fortified.FFF_TimedSiteExtension">
        <baseEntryHours>24</baseEntryHours>
        <minEntryHours>6</minEntryHours>
        <maxEntryHours>48</maxEntryHours>
        <entryLetterLabelKey>DMSAC_Site_EntryCountdownLabel</entryLetterLabelKey>
        <entryLetterTextKey>DMSAC_Site_EntryCountdownText</entryLetterTextKey>
      </li>
      <!-- 設施入口：最重的地表守備；五級警戒時連掃蕩型稜堡都會守在井口。
           The facility entrance: the heaviest surface garrison; at DEFCON 5 even the sweeper Krepost guards the shaft. -->
      <li Class="AncientCorps.ModExtension_SiteGarrison">
        <pointsFactor>1.3</pointsFactor>
        <minPoints>800</minPoints>
        <maxPoints>8000</maxPoints>
        <tiers>
          <li>
            <minDefcon>0</minDefcon>
            <options>
              <DMS_Mech_Mushketer_AR>4</DMS_Mech_Mushketer_AR>
              <DMS_Mech_Mushketer_SAR>3</DMS_Mech_Mushketer_SAR>
              <DMS_Mech_Molot_Mosta>1</DMS_Mech_Molot_Mosta>
              <DMS_Mech_BattleWalker>1</DMS_Mech_BattleWalker>
            </options>
          </li>
          <li>
            <minDefcon>1</minDefcon>
            <options>
              <DMS_Mech_Zabor>1</DMS_Mech_Zabor>
              <DMS_Mech_Gorod>1</DMS_Mech_Gorod>
            </options>
          </li>
          <li>
            <minDefcon>2</minDefcon>
            <options>
              <DMS_Mech_Zabor_Shkatulka>1</DMS_Mech_Zabor_Shkatulka>
              <DMS_Mech_Gorod_Cornetist>0.4</DMS_Mech_Gorod_Cornetist>
              <DMS_Mech_CommandWalker>0.3</DMS_Mech_CommandWalker>
            </options>
          </li>
          <li>
            <minDefcon>3</minDefcon>
            <options>
              <DMS_Mech_Tsvetnik>0.5</DMS_Mech_Tsvetnik>
              <DMS_Mech_Krepost>0.4</DMS_Mech_Krepost>
              <DMS_Mech_Pravda>0.3</DMS_Mech_Pravda>
            </options>
          </li>
          <li>
            <minDefcon>5</minDefcon>
            <options>
              <DMS_Mech_Krepost_Sweeper>0.5</DMS_Mech_Krepost_Sweeper>
            </options>
          </li>
        </tiers>
