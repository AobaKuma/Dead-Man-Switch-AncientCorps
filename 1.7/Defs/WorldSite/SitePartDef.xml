  <!-- ======================= 物流終端站 Logistic terminal ======================= -->
  <SitePartDef>
    <defName>DMSAC_LogisticTerminal</defName>
    <label>logistic terminal</label>
    <!-- 一個自動運行的前線物資終端站，透過自動砲塔與不間斷巡邏的機兵巡邏隊防守。這樣的小型終端站是為那些進行特遣任務的連級機兵部隊所供他們彈藥補充與回收受損的機兵。 -->
    <description>An automatically operated frontline supply terminal, defended by automatic turrets and automatroid patrols. Such small terminals are used by company-level automatroid squads to replenish ammunition and recycle damaged automatroids.</description>
    <workerClass>AncientCorps.SitePartWorker_DMSAC_Installation</workerClass>
    <modExtensions>
      <li Class="Fortified.FFF_TimedSiteExtension">
        <baseEntryHours>24</baseEntryHours>
        <minEntryHours>6</minEntryHours>
        <maxEntryHours>48</maxEntryHours>
        <entryLetterLabelKey>DMSAC_Site_EntryCountdownLabel</entryLetterLabelKey>
        <entryLetterTextKey>DMSAC_Site_EntryCountdownText</entryLetterTextKey>
      </li>
      <!-- 終端站主要靠砲塔，守軍是最小的一班。The terminal leans on its turrets; the garrison is the smallest squad. -->
      <li Class="AncientCorps.ModExtension_SiteGarrison">
        <pointsFactor>0.5</pointsFactor>
        <minPoints>250</minPoints>
        <maxPoints>2000</maxPoints>
        <tiers>
          <li>
            <minDefcon>0</minDefcon>
            <options>
              <DMS_Mech_Mushketer_AR>3</DMS_Mech_Mushketer_AR>
              <DMS_Mech_Mushketer_SAR>3</DMS_Mech_Mushketer_SAR>
              <DMS_Mech_Molot>1</DMS_Mech_Molot>
            </options>
          </li>
          <li>
            <minDefcon>2</minDefcon>
            <options>
              <DMS_Mech_BattleWalker>1</DMS_Mech_BattleWalker>
            </options>
          </li>
          <li>
            <minDefcon>3</minDefcon>
            <options>
              <DMS_Mech_Zabor>0.5</DMS_Mech_Zabor>
            </options>
          </li>
        </tiers>
      </li>
    </modExtensions>
    <siteTexture>UI/Icons/LogisticTerminal_Site</siteTexture>
