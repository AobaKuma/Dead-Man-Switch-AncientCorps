<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    軍團站點（照 DMS2 NewContent 的站點寫法重寫）：
      SitePartDef  workerClass = AncientCorps.SitePartWorker_DMSAC_Installation
                   ├ Fortified.FFF_TimedSiteExtension ：進入後的增援倒數（小時 ÷ 難度 threatScale）。
                   │  世界生成、帶巡邏隊（WorldObjectComp_PatrolSquad）的站點由巡邏隊增援，不另外倒數。
                   └ AncientCorps.ModExtension_SiteGarrison ：守軍 = 威脅點數 × pointsFactor（站點類型）
                      × defconPointsFactor（警戒等級），兵種由 tiers 依警戒等級累加後抽。
      GenStepDef   AncientCorps.GenStep_DMSAC_GarrisonedStructure：用 useTag 挑 Structures_*.xml 的佈局，
                   殘骸、戰利品、外圍廢墟（DMS2 的 DMS_RuinSatellite / DMS_RuinScattered）照 FFF。
    label / description 維持原文，根目錄 Languages 的翻譯仍然有效。

    Corps sites, rewritten the way DMS2's NewContent sites are built:
      SitePartDef  worker AncientCorps.SitePartWorker_DMSAC_Installation
                   ├ FFF_TimedSiteExtension: post-entry reinforcement countdown (hours ÷ threatScale); world-gen sites
                   │  with a patrol squad keep the patrols as their reinforcement instead.
                   └ ModExtension_SiteGarrison: garrison = threat points × pointsFactor (site type) × defconPointsFactor
                      (DEFCON); units rolled from the tiers unlocked at the current DEFCON.
      GenStepDef   AncientCorps.GenStep_DMSAC_GarrisonedStructure picks a Structures_*.xml layout by useTag; debris,
                   loot and satellite ruins (DMS2's DMS_RuinSatellite / DMS_RuinScattered) are FFF's.
    Labels and descriptions are unchanged, so the root Languages translations still apply.
  -->

  <!-- ======================= 兵器墳場 Automatroid graveyard ======================= -->
  <SitePartDef>
    <defName>DMSAC_Graveyard</defName>
    <label>Automatroid graveyard</label>
    <description>An open graveyard with a large number of decommissioned automatroids from the Corp piled up.\n\nLocal scavengers and raiders often sneaked in and stole parts to repair their automatroids, so the Corp deployed an automatroid garrison.</description>
    <workerClass>AncientCorps.SitePartWorker_DMSAC_Installation</workerClass>
    <modExtensions>
      <li Class="Fortified.FFF_TimedSiteExtension">
        <baseEntryHours>36</baseEntryHours>
        <minEntryHours>8</minEntryHours>
        <maxEntryHours>72</maxEntryHours>
        <entryLetterLabelKey>DMSAC_Site_EntryCountdownLabel</entryLetterLabelKey>
        <entryLetterTextKey>DMSAC_Site_EntryCountdownText</entryLetterTextKey>
      </li>
      <!-- 墳場守衛：步兵為主，警戒升高後才調來重型機兵。Graveyard guards: infantry first, heavies as DEFCON rises. -->
      <li Class="AncientCorps.ModExtension_SiteGarrison">
        <pointsFactor>1</pointsFactor>
        <minPoints>400</minPoints>
        <maxPoints>5000</maxPoints>
        <tiers>
          <li>
            <minDefcon>0</minDefcon>
            <options>
              <DMS_Mech_Mushketer_AR>4</DMS_Mech_Mushketer_AR>
              <DMS_Mech_Mushketer_SAR>2</DMS_Mech_Mushketer_SAR>
              <DMS_Mech_Molot>2</DMS_Mech_Molot>
              <DMS_Mech_Molot_Mosta>1</DMS_Mech_Molot_Mosta>
            </options>
          </li>
          <li>
            <minDefcon>1</minDefcon>
            <options>
              <DMS_Mech_BattleWalker>1</DMS_Mech_BattleWalker>
              <DMS_Mech_Zabor>1</DMS_Mech_Zabor>
            </options>
          </li>
          <li>
            <minDefcon>2</minDefcon>
            <options>
              <DMS_Mech_Gorod>1</DMS_Mech_Gorod>
              <DMS_Mech_Zabor_Shkatulka>0.5</DMS_Mech_Zabor_Shkatulka>
            </options>
          </li>
          <li>
            <minDefcon>3</minDefcon>
            <options>
              <DMS_Mech_Tsvetnik>0.5</DMS_Mech_Tsvetnik>
              <DMS_Mech_Krepost_Sweeper>0.25</DMS_Mech_Krepost_Sweeper>
            </options>
          </li>
        </tiers>
      </li>
    </modExtensions>
    <siteTexture>UI/Icons/Graveyard_Site</siteTexture>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <expandingIconTexture>UI/Icons/Graveyard_Icon</expandingIconTexture>
    <showFactionInInspectString>true</showFactionInInspectString>
    <requiresFaction>true</requiresFaction>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>400</minThreatPoints>
    <considerEnteringAsAttack>true</considerEnteringAsAttack>
    <!-- 倒數由 worker 依難度自己啟動。The worker starts its own difficulty-scaled countdown. -->
    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
    <approachOrderString>Investigate {0}</approachOrderString>
    <approachingReportString>Investigate {0}</approachingReportString>
    <arrivedLetterDef>ThreatSmall</arrivedLetterDef>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <minMapSize>(150, 1, 150)</minMapSize>
    <tags>
      <li>DMSAC_Graveyard</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>DMSAC_Graveyard</defName>
    <linkWithSite>DMSAC_Graveyard</linkWithSite>
    <order>400</order>
    <genStep Class="AncientCorps.GenStep_DMSAC_GarrisonedStructure">
      <forcedFaction>DMS_AncientCorps</forcedFaction>
      <useTag>DMSAC_Graveyard</useTag>
      <randomOffset>0~3</randomOffset>
      <randomRotation>true</randomRotation>
      <fullClear>true</fullClear>
      <preventBridgeable>true</preventBridgeable>
      <filthTypes>
        <li>Filth_Dirt</li>
        <li>Filth_Trash</li>
        <li>Filth_RubbleBuilding</li>
      </filthTypes>
      <symbolResolvers>
        <li>kcsg_storagezone</li>
        <li>kcsg_randomdamage</li>
        <li>kcsg_randomfilth</li>
        <li>kcsg_randomterrainremoval</li>
        <li>kcsg_randomroofremoval</li>
        <li>kcsg_randomitemremoval</li>
      </symbolResolvers>
      <!-- 佈局本身已經堆滿殘骸，這裡只在外圍補一些。The layouts are already full of hulks; just a few more outside. -->
      <debrisDef>DMSAC_Building_DerelictMech_Medium</debrisDef>
      <debrisCount>4~8</debrisCount>
      <scatterRadius>34</scatterRadius>
      <lootMaker>DMSAC_LootMaker</lootMaker>
      <defendRadius>20</defendRadius>
      <satelliteScatter>
        <li>
          <tag>DMSAC_GraveyardSatellite</tag>
          <count>1~2</count>
          <radiusPct>0.3</radiusPct>
          <minRadius>48</minRadius>
          <minSpacing>6</minSpacing>
        </li>
        <li>
          <tag>DMS_RuinSatellite</tag>
          <count>2~3</count>
          <radiusPct>0.22</radiusPct>
          <minRadius>44</minRadius>
          <minSpacing>5</minSpacing>
        </li>
      </satelliteScatter>
    </genStep>
  </GenStepDef>

