            </options>
          </li>
          <li>
            <minDefcon>2</minDefcon>
            <options>
              <DMS_Mech_Gorod>1</DMS_Mech_Gorod>
              <DMS_Mech_Gorod_Piper>0.5</DMS_Mech_Gorod_Piper>
            </options>
          </li>
          <li>
            <minDefcon>3</minDefcon>
            <options>
              <DMS_Mech_Zabor_Shkatulka>1</DMS_Mech_Zabor_Shkatulka>
              <DMS_Mech_Krepost>0.3</DMS_Mech_Krepost>
            </options>
          </li>
        </tiers>
      </li>
