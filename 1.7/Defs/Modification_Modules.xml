  <ThingDef ParentName="BaseModificationItem">
    <defName>DMSAC_Mod_RocketNest</defName>
    <label>cluster rocket nest</label>
    <description>The helicopter-derived cluster rocket nest, adapted to a walker's module rack. Nine tubes fire in a single ripple, covering a wide arc in front of the machine.\n\nThe nest is the single heaviest thing you can bolt onto these chassis, and the machine walks like it knows.</description>
    <descriptionHyperlinks>
      <HediffDef>DMSAC_Mod_RocketNest</HediffDef>
      <AbilityDef>DMSAC_Rocket</AbilityDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Projectiles/DMS_S8Rocket/projectile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>12</Mass>
      <MarketValue>1200</MarketValue>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <Tungsteel>25</Tungsteel>
      <ComponentStamped>3</ComponentStamped>
    </costList>
    <recipeMaker>
      <workAmount>5400</workAmount>
