  <ThingDef ParentName="BaseModificationItem">
    <defName>DMSAC_Mod_Flamer</defName>
    <label>flamer module</label>
    <description>A pressure tank and projector taken from a vehicle flamethrower, mounted on the module rack. The fuel is carried as a gunpowder-ignited charge, so the projector throws a single long tongue of burning fuel rather than a steady stream.</description>
