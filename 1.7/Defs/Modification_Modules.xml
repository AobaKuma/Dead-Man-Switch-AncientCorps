<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    模塊（《DMS2更新計畫》「可安裝的模塊」與「籬笆／城邦共用模塊池」）。
    沿用 DMS2 的 Modification 三段式：ThingDef（ParentName=BaseModificationItem）＋
    HediffDef（Fortified.HediffCompProperties_Modification ＋ stages ＋ <abilities>）＋
    Fortified.CompProperties_AddHediffOnTarget 指定可安裝的機種。

    Mech modules, following DMS2's Modification pattern (item + hediff + AddHediffOnTarget).
    支援機種 / supported chassis: Zabor, Gorod, Molot, BattleFrame(戰鬥步行者).
  -->
  <ThingDef ParentName="BaseModificationItem">
    <defName>DMSAC_Mod_Kornet</defName>
    <label>Kornet launcher mount</label>
    <description>A single 9M133 Kornet tube bolted to the module rack, wired into the chassis fire control chain. Two guided anti-tank missiles are carried; once they are gone the mount is dead weight until the next refit.\n\nThe tube is heavy and the backblast is enormous, so the chassis pays for it in walking pace and cargo room.</description>
    <descriptionHyperlinks>
      <HediffDef>DMSAC_Mod_Kornet</HediffDef>
      <AbilityDef>DMSAC_ATGMLauncher</AbilityDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Projectiles/DMS_9M133Missile/tripod</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>8</Mass>
      <MarketValue>900</MarketValue>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <Tungsteel>20</Tungsteel>
      <ComponentStamped>2</ComponentStamped>
    </costList>
    <recipeMaker>
      <workAmount>4200</workAmount>
      <researchPrerequisite>DMS_Occultech_MainBattle</researchPrerequisite>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>DMS_TableMachinePrinter</li>
      </recipeUsers>
    </recipeMaker>
    <comps>
      <li Class="Fortified.CompProperties_AddHediffOnTarget">
        <compClass>Fortified.CompTargetable_AddHediffOnTarget</compClass>
        <hediffDef>DMSAC_Mod_Kornet</hediffDef>
        <soundDef>DMS_EquipGear</soundDef>
        <supportRaceDefs>
          <li>DMS_Mech_Zabor</li>
          <li>DMS_Mech_Gorod</li>
          <li>DMS_Mech_Molot</li>
          <li>DMS_Mech_BattleFrame</li>
        </supportRaceDefs>
        <targetBodyPartDefs />
      </li>
    </comps>
  </ThingDef>

  <HediffDef>
    <defName>DMSAC_Mod_Kornet</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>Kornet launcher mount</label>
    <description>A 9M133 Kornet tube on the module rack.</description>
    <descriptionHyperlinks>
      <ThingDef>DMSAC_Mod_Kornet</ThingDef>
      <AbilityDef>DMSAC_ATGMLauncher</AbilityDef>
    </descriptionHyperlinks>
    <defaultLabelColor>(1, 1, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <spawnThingOnRemoved>DMSAC_Mod_Kornet</spawnThingOnRemoved>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.9</MoveSpeed>
        </statFactors>
        <statOffsets>
          <Mass>8</Mass>
          <CarryingCapacity>-10</CarryingCapacity>
          <MechEnergyUsageFactor>0.05</MechEnergyUsageFactor>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="Fortified.HediffCompProperties_Modification">
        <applyJob>FFF_ModificationRemove</applyJob>
      </li>
    </comps>
    <abilities>
      <li>DMSAC_ATGMLauncher</li>
    </abilities>
  </HediffDef>

  <ThingDef ParentName="BaseModificationItem">
