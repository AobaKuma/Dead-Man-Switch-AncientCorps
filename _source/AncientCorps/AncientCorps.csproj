<Project Sdk="Microsoft.NET.Sdk">

  <!--
    1.7 分支只建置 net10.0（RimWorld 1.7 / .NET 10 / Waylith / Harmony 3）→ 1.7/Assemblies。
    1.6（net472）分支已凍結，不再隨 1.6 的內容更新重建；因此這裡不列入 TargetFrameworks，
    避免 `dotnet build` 覆蓋 1.6/Assemblies 內凍結的 DLL。若日後要對 1.6 做 backport：
      1. 把 TargetFrameworks 改回 net472;net10.0
      2. 取消下方 net472 區塊的註解（Krafs.Rimworld.Ref + Lib.Harmony 2.4.2）
      3. 用 `#if RW_1_7` 圍住只存在於 1.7 內容的 Def 參照（例如新增的 DMSAC_* defName）
    The 1.7 branch builds net10.0 only (RimWorld 1.7 / .NET 10 / Waylith / Harmony 3) into 1.7/Assemblies.
    The 1.6 (net472) branch is frozen and is no longer rebuilt alongside 1.6 content, so net472 is not a
    target here — that keeps `dotnet build` from overwriting the frozen DLL in 1.6/Assemblies.
    To backport to 1.6 later: restore TargetFrameworks to net472;net10.0, re-enable the net472 block below
    (Krafs.Rimworld.Ref + Lib.Harmony 2.4.2), and fence 1.7-only Def references with `#if RW_1_7`.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>AncientCorps</RootNamespace>
    <AssemblyName>AncientCorps</AssemblyName>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- Properties/AssemblyInfo.cs 已提供組件屬性。Properties/AssemblyInfo.cs already supplies the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</RimWorldDir>
    <!--
      FFF 的組件路徑。本模組現在會直接呼叫 Fortified 的 API（例如 HuntdownUtility、CompMultipleTurretGun），
      所以需要參考 Fortified.dll；它會在 AOBA.Framework 之後載入（About.xml 的 loadAfter）。
      工作坊安裝的資料夾名稱不同時，以 -p:FortifiedDir=<路徑>\ 覆寫。
      FFF assembly location. The mod now calls Fortified APIs directly (HuntdownUtility, CompMultipleTurretGun…),
      so Fortified.dll is referenced; it loads before us via AOBA.Framework + loadAfter. Override the folder with
      -p:FortifiedDir=<path>\ when the framework lives in a differently named workshop folder.
    -->
    <FortifiedDir Condition="'$(FortifiedDir)' == ''">$(RimWorldDir)Mods\_Fortified-Framework\1.7\</FortifiedDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputPath>$(MSBuildThisFileDirectory)..\..\1.7\Assemblies\</OutputPath>
    <DefineConstants>$(DefineConstants);RW_1_7</DefineConstants>
    <!-- 遊戲只載入 Assemblies 內的 .dll，不需要 deps.json。The game only loads the .dll, so no deps.json. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 舊專案也沒有編譯這個檔案。The old project did not compile this file either. -->
    <Compile Remove="GameCondition_Planetkiller.cs" />
  </ItemGroup>

  <!-- 1.6 backport 用；平日不啟用 / only for a 1.6 backport:
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <OutputPath>$(MSBuildThisFileDirectory)..\..\1.6\Assemblies\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4850" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
  </ItemGroup>
  -->

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- 與 Harmony 模組 1.7 資料夾內的 0Harmony.dll 完全相同（3.0.0-rc.2）。Identical to the Harmony mod's 1.7 0Harmony.dll. -->
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" ExcludeAssets="runtime" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 1.7 的 UnityEngine.* 型別全部由 UnityStubs 提供。In 1.7 every UnityEngine.* type comes from UnityStubs. -->
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Fortified">
      <HintPath>$(FortifiedDir)Assemblies\Fortified.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
