<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       DEPRECATED / SAVE-COMPATIBILITY ONLY.

       These walls and the facility door were moved into the
       Fortified Features Framework as FFF_Wall_A/B/C and FFF_RCdoor.
       The old defNames are kept here so buildings placed in existing
       saves keep loading. Do NOT reference them in new content —
       use the FFF_* defs instead.
       ============================================================ -->

  <ThingDef ParentName="FFF_FacilityWallBase">
    <defName>DMSAC_Wall_A</defName>
    <label>facility wall</label>
    <description>A structure with waterproof layers, commonly found in underground facilities.</description>
    <graphicData>
      <texPath>Things/Building/Linked/Wall/Wall_Atlas_Concrete</texPath>
    </graphicData>
    <uiIconPath>Things/Building/Linked/Wall/Wall_Atlas_Concrete_UI</uiIconPath>
  </ThingDef>

  <ThingDef ParentName="FFF_FacilityWallBase">
    <defName>DMSAC_Wall_B</defName>
    <label>facility wall</label>
    <description>A structure with waterproof layers, commonly found in underground facilities.</description>
    <graphicData>
      <texPath>Things/Building/Linked/Wall/Wall_Atlas_LoadBearing</texPath>
    </graphicData>
    <uiIconPath>Things/Building/Linked/Wall/Wall_Atlas_LoadBearing_UI</uiIconPath>
  </ThingDef>

  <ThingDef ParentName="FFF_FacilityWallBase">
    <defName>DMSAC_Wall_C</defName>
    <label>facility wall</label>
    <description>A structure with waterproof layers, commonly found in underground facilities.</description>
    <graphicData>
      <texPath>Things/Building/Linked/Wall/Wall_Atlas_Concrete_Icon</texPath>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconPath>Things/Building/Linked/Wall/Wall_Atlas_Concrete_Icon_UI</uiIconPath>
  </ThingDef>

  <ThingDef ParentName="FFF_FacilityDoorBase">
    <defName>DMSAC_RCdoor</defName>
    <label>facility door</label>
    <description>Divides rooms. allows people to move through the door without slowing down.</description>
    <statBases>
      <WorkToBuild>1100</WorkToBuild>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Door/DMS_Door_Mover</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Door/DMS_Door_MenuIcon</uiIconPath>
    <costList>
      <Steel>20</Steel>
    </costList>
  </ThingDef>

</Defs>
